{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "esModuleInterop": true, "skipLibCheck": true, "strict": false, "noEmit": true, "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "paths": { "@/*": ["client/app/src/*"], "@shared/*": ["shared/*"], "@assets/*": ["attached_assets/*"] }
  },
  "include": ["client/app/src/**/*", "shared/**/*", "server/**/*", "tests/**/*"]
}
