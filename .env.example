# Copie para as variáveis de ambiente do app no Coolify. Nunca suba valores reais para o Git.
NODE_ENV=production
PORT=3000
APP_URL=https://calculoamostral.com.br
DATABASE_URL=postgres://usuario:senha@host:5432/calculoamostral
# 48+ caracteres aleatórios: openssl rand -base64 48
SESSION_SECRET=

# Resend (mesma conta do Replit, chave própria restrita a acesso.calculoamostral.com.br)
RESEND_API_KEY=
MAIL_FROM=Psicometria Online <codigo@acesso.calculoamostral.com.br>
MAIL_REPLY_TO=
MAIL_PER_SECOND=2
MAIL_DAILY_CAP=3000

# Cloudflare Turnstile (anti-robô)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ActiveCampaign: só base de contatos (sem lista, sem automação, sem envio)
AC_ENABLED=true
AC_API_URL=https://psicometriaonline.api-us1.com
AC_API_KEY=
AC_TAG_SIGNUP=[POA][CALC] - Cadastro
AC_TAG_USED_POWER=[POA][CALC] - Usou poder
AC_TAG_USED_PRECISION=[POA][CALC] - Usou precisão
AC_TAG_SAVED=[POA][CALC] - Salvou cálculo
# id do campo personalizado "Calculadora: aceite de marketing" (criado no deploy)
AC_MARKETING_FIELD_ID=
